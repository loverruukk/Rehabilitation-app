// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLINICIAN
  PATIENT
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  hashedPassword   String
  role             UserRole
  patient          Patient?
  clinician        Clinician?
  sentMessages     SecureMessage[] @relation("SentMessages")
  receivedMessages SecureMessage[] @relation("ReceivedMessages")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Patient {
  id               String          @id @default(cuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id])
  dateOfBirth      DateTime?
  phone            String?
  emergencyContact String?
  rehabPlans       RehabPlan[]
  checkins         DailyCheckin[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Clinician {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id])
  specialty       String?
  licenseNumber   String?
  bio             String?
  rehabPlans      RehabPlan[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Exercise {
  id           String         @id @default(cuid())
  name         String
  description  String?
  targetArea   String?
  difficulty   String?
  videoUrl     String?
  planExercises PlanExercise[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model RehabPlan {
  id              String          @id @default(cuid())
  patientId       String
  patient         Patient         @relation(fields: [patientId], references: [id])
  clinicianId     String?
  clinician       Clinician?      @relation(fields: [clinicianId], references: [id])
  title           String
  goal            String?
  startDate       DateTime        @default(now())
  endDate         DateTime?
  status          String          @default("ACTIVE")
  planExercises   PlanExercise[]
  dailyCheckins   DailyCheckin[]
  messages        SecureMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model PlanExercise {
  id               String    @id @default(cuid())
  planId           String
  plan             RehabPlan @relation(fields: [planId], references: [id])
  exerciseId       String
  exercise         Exercise  @relation(fields: [exerciseId], references: [id])
  sequenceOrder    Int?
  sets             Int?
  repetitions      Int?
  holdSeconds      Int?
  frequencyPerWeek Int?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([planId, exerciseId])
}

model DailyCheckin {
  id           String    @id @default(cuid())
  planId       String
  plan         RehabPlan @relation(fields: [planId], references: [id])
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  checkinDate  DateTime  @default(now())
  mood         String?
  painLevel    Int?
  adherence    Int?
  notes        String?
  createdAt    DateTime  @default(now())

  @@unique([patientId, checkinDate])
}

model SecureMessage {
  id          String    @id @default(cuid())
  planId      String?
  plan        RehabPlan? @relation(fields: [planId], references: [id])
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  subject     String?
  body        String
  sentAt      DateTime  @default(now())
  readAt      DateTime?
}
